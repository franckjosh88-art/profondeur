rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Auth helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users resource
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Bookmarks subcollection
      match /bookmarks/{bookmarkId} {
        allow read, write: if isOwner(userId);
      }

      // Bookmark folders subcollection
      match /bookmark_folders/{folderId} {
        allow read, write: if isOwner(userId);
      }

      // Notes subcollection
      match /notes/{noteId} {
        allow read, write: if isOwner(userId);
      }

      // History subcollection
      match /history/{historyId} {
        allow read, write: if isOwner(userId);
      }

      // Chapter meditations subcollection
      match /chapter_meditations/{meditationId} {
        allow read, write: if isOwner(userId);
      }

      // Chapter audio meditations subcollection
      match /chapter_audio_meditations/{audioId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
